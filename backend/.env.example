# ==========================================
# BACKEND & ETL ENVIRONMENT VARIABLES
# ==========================================

# Puerto de la API
PORT=8000
ENVIRONMENT=development

# Conexión directa a PostgreSQL (Supabase / Neon)
# Ejemplo: postgresql+psycopg2://postgres.xxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres
DIRECT_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres

# Credenciales de API de Supabase (Opcional si se usa REST API Client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Metadatos del Dataset
DATASET_RAW_PATH=docs/data_set/Reporte__Delitos_sexuales_Policía_Nacional_20261106.csv
DATASET_CLEAN_PATH=docs/data_set/delitos_sexuales_atlantico_limpio.csv
FECHA_DESCARGA_DATASET=2026-11-06
DEPARTAMENTO_OBJETIVO=ATLÁNTICO

